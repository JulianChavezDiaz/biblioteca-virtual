// Esquema de base de datos para Biblioteca Digital.
// Reemplaza las tablas que antes vivían en Supabase. Los nombres de tabla y
// columna se mapean a snake_case para mantener compatibilidad con la app Flutter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  // Opcional: los usuarios importados de Supabase reciben su hash bcrypt desde auth.users.
  passwordHash String?  @map("password_hash")
  name         String
  // Roles reales en la BD: admin | bibliotecario | profesor | lector | user
  role         String   @default("user")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  books           Book[]
  categories      Category[]
  favorites       Favorite[]
  supportRequests SupportRequest[]
  bookOpens       BookOpenHistory[]
  readingHistory  ReadingHistory[]
  resetTokens     PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model Book {
  id            String    @id @default(uuid()) @db.Uuid
  title         String
  author        String
  description   String?
  coverUrl      String?   @map("cover_url")
  fileUrl       String?   @map("file_url")
  format        String? // pdf | epub
  categories    String[]  @default([])
  category      String?
  subcategory   String?
  isbn          String?
  year          Int?
  publishedDate DateTime? @map("published_date")
  // Libros físicos
  isPhysical       Boolean @default(false) @map("is_physical")
  physicalLocation String? @map("physical_location")
  codigoFisico     String? @map("codigo_fisico")
  isPhysicalOnly   Boolean @default(false) @map("is_physical_only")
  deletedAt        DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")

  creator        User?             @relation(fields: [createdBy], references: [id])
  favorites      Favorite[]
  stats          BookStats?
  opens          BookOpenHistory[]
  readingHistory ReadingHistory[]

  @@map("books")
}

model Video {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  thumbnailUrl String?  @map("thumbnail_url")
  videoId      String   @map("video_id") // id de YouTube
  category     String
  subcategory  String?
  duration     Int?
  views        Int      @default(0)
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("videos")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  creator User? @relation(fields: [createdBy], references: [id])

  @@map("categories")
}

model Favorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("favorites")
}

model SupportRequest {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String
  type        String // ayuda | configuracion | reporte | otro
  status      String    @default("pendiente") // pendiente | resuelto
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_requests")
}

model BookStats {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @unique @map("book_id") @db.Uuid
  openCount Int      @default(0) @map("open_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("book_stats")
}

model BookOpenHistory {
  id       String   @id @default(uuid()) @db.Uuid
  bookId   String   @map("book_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  openedAt DateTime @default(now()) @map("opened_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("book_opens_history")
}

model ReadingHistory {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  bookId   String   @map("book_id") @db.Uuid
  progress Int      @default(0)
  lastRead DateTime @default(now()) @map("last_read")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("reading_history")
}
