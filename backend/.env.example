# Conexión a Postgres (coincide con docker-compose.yml)
DATABASE_URL="postgresql://biblioteca:biblioteca@localhost:5432/biblioteca?schema=public"

# Secreto para firmar los JWT. CÁMBIALO en producción por un valor largo y aleatorio.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Orígenes permitidos para CORS (separados por coma). Usa * para permitir todos en desarrollo.
CORS_ORIGIN="*"

# URL del frontend (usada en el enlace del correo de restablecimiento).
APP_URL="http://localhost:8080"

# SMTP para envío de correos (restablecimiento de contraseña).
# Si se deja vacío, el reset no envía correo (solo avisa por consola).
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Biblioteca Digital <no-reply@tudominio.com>"
